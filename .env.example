# ==============================================================================
# CryptX Platform — Environment Configuration Template (.env.example)
# Copy this file to .env and configure real secrets for your deployment.
# NEVER commit .env files containing real credentials to version control.
# ==============================================================================

# PostgreSQL Database Service (Docker Compose)
POSTGRES_USER=cryptx_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=cryptx

# JWT Security
# Minimum 32 characters random secret for HMAC-SHA256 token signing
JWT_SECRET_KEY=replace_with_secure_random_jwt_secret_key_minimum_32_characters

# Master Key Encryption Key (KEK)
# Exactly 32 bytes (256-bit) Base64 encoded key
# Generate via: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
CRYPTX_MASTER_KEY=replace_with_base64_encoded_32_byte_master_kek==

# CORS Allowed Origins (comma-separated URLs, include your Vercel frontend domain)
# Example: https://cryptx.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API Target (Vite)
# Local Dev: http://127.0.0.1:8000
# Production: https://cryptx-backend.fastapicloud.dev
VITE_API_BASE_URL=http://127.0.0.1:8000
