# ==============================================================================
# CryptX Backend — Environment Configuration Template (backend/.env.example)
# Copy this file to backend/.env for local development.
# ==============================================================================

# Application Metadata
PROJECT_NAME="CryptX Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
# Required: Minimum 32-character random string for HMAC-SHA256 JWT signing
JWT_SECRET_KEY="replace_with_secure_random_jwt_secret_key_minimum_32_characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cryptography — Master Key Encryption Key (KEK)
# Required: Exactly 32 bytes (256-bit) Base64 encoded key
# Generate via: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
CRYPTX_MASTER_KEY="replace_with_base64_encoded_32_byte_master_kek=="

# Database Connection URL
# PostgreSQL: postgresql://cryptx_user:your_password@localhost:5432/cryptx
# SQLite (Local Testing / Dev): sqlite:///./cryptx.db
DATABASE_URL="sqlite:///./cryptx.db"

# Storage Settings
STORAGE_DIR="storage/uploads"
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
